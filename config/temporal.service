[Unit]
Description=Temporal server
Wants=network-online.target
After=network-online.target

[Service]
User=temporal
Group=temporal
EnvironmentFile=/etc/temporal/temporal.env
WorkingDirectory=/var/lib/temporal
SyslogIdentifier=temporal
ExecStart=/opt/temporal/current/temporal-server --config-file /etc/temporal/temporal.yaml --allow-no-auth start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/temporal

[Install]
WantedBy=multi-user.target
