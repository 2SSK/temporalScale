[Unit]
Description=Temporal host firewall (TEMPORAL_INPUT chain)
DefaultDependencies=no
Wants=network-pre.target
After=systemd-modules-load.service local-fs.target
Before=network-pre.target shutdown.target temporal.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/iptables-restore --noflush /etc/temporal/firewall.rules
ExecStart=/usr/sbin/ip6tables-restore --noflush /etc/temporal/firewall6.rules
ExecStart=/bin/sh -c 'iptables -C INPUT -j TEMPORAL_INPUT 2>/dev/null || iptables -I INPUT 1 -j TEMPORAL_INPUT'
ExecStart=/bin/sh -c 'ip6tables -C INPUT -j TEMPORAL_INPUT 2>/dev/null || ip6tables -I INPUT 1 -j TEMPORAL_INPUT'

[Install]
WantedBy=multi-user.target
