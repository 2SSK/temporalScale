# .env.example - Copy to .env; identical on every server of a cluster. Passwords: [A-Za-z0-9._~-] only.
TEMPORAL_VERSION=1.31.3
TEMPORAL_CLI_VERSION=1.9.1
SERVER_PROFILE=4c16g
# Fixed forever at the cluster's first start: e.g. 1024 for staging, 4096 for production.
NUM_HISTORY_SHARDS=1024
LOG_LEVEL=info

# Private IP of every server; each server finds its own IP here.
CLUSTER_IPS="10.0.0.4 10.0.0.5"
# Allowed to call the frontend on 7233 (workers, starters).
CLIENT_IPS="203.0.113.10 203.0.113.11"
# Allowed to scrape :9091 (Temporal) and :9100 (node_exporter).
MONITOR_IPS="198.51.100.20"
# Allowed to open the Web UI on :80.
ADMIN_IPS="198.51.100.30"
# Allowed to GET /health on :80 (Cloudflare health-check ranges).
HEALTHCHECK_IPS=""

NAMESPACES="default"
NAMESPACE_RETENTION=72h

DB_HOST=db.example.com
DB_PORT=5432
DB_USER=temporal
DB_PASSWORD=change-me
DB_TLS=false
# Database used for existence checks; set it if the server refuses CONNECT on postgres.
DB_ADMIN_DATABASE=postgres

TEMPORAL_UI_VERSION=2.54.1
TEMPORAL_UI_TARGET=127.0.0.1:7233
UI_PORT=8080
TEMPORAL_CORS_ORIGINS=http://localhost:8080
UI_MEM_LIMIT=512m
UI_MEM_RESERVATION=128m
UI_CPUS=1.0
UI_LOG_MAX_SIZE=50m
UI_LOG_MAX_FILE=3
